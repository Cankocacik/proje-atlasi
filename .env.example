# Sunucuda bu dosyayı .env adıyla kopyala; .env repoya girmez.

# Oturum çerezinin imza sırrı — `npm run sir` üretir.
ATLAS_OTURUM_SIRRI=
# Oturum süresi (gün)
ATLAS_OTURUM_GUN=7

# Giriş Rosbel portal kullanıcısıyla (e-posta ecosystem.config.cjs'te).
# Portal backend'i başka portta çalışıyorsa:
# ATLAS_PORTAL_GIRIS_URL=http://127.0.0.1:4000/api/auth/login

# Portal yerine ayrı parola istenirse (ATLAS_PORTAL_EPOSTA boşken): `npm run parola`
# ATLAS_PAROLA_HASH=

# GitHub ince ayarlı token: yalnız Contents=Read + Metadata=Read, yalnız ilgili repolar
GITHUB_TOKEN=
